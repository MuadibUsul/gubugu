# Required in production. Without it every data module falls back to empty
# state, so the site renders a blank encyclopedia and still returns HTTP 200.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gubugu"

# Required in production. Leave the Supabase block unset for local development
# to use the demo viewers in lib/config/demo-viewers.ts, which sign in without
# a credential check and grant `collector` the admin role.
# lib/supabase/config.ts prefers the NEXT_PUBLIC_ names and falls back to the
# server-only ones. Set the NEXT_PUBLIC_ pair unless you have a reason not to.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"

# Reserved for future server-side Supabase access. Nothing reads it today.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional. Only NEXT_PUBLIC_APP_URL is read (lib/demo-assets.ts), and it has a
# fallback.
NEXT_PUBLIC_APP_NAME="Gooods Dex"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated allowlists checked by lib/admin-access.ts.
ADMIN_USER_EMAILS="admin@example.com"
ADMIN_USER_IDS=""
MODERATOR_USER_EMAILS=""
MODERATOR_USER_IDS=""
