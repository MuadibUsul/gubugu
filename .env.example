# Required in production. Without it every data module falls back to empty
# state, so the site renders a blank encyclopedia and still returns HTTP 200.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gubugu"

# Required when Supabase is unset and local PostgreSQL auth is used. Generate
# an unpredictable value of at least 32 characters; never commit the real one.
LOCAL_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Required in production. Leave the Supabase block unset for local development
# to use local PostgreSQL registration and password login.
# lib/supabase/config.ts prefers the NEXT_PUBLIC_ names and falls back to the
# server-only ones. Set the NEXT_PUBLIC_ pair unless you have a reason not to.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"

# Reserved for future server-side Supabase access. Nothing reads it today.
SUPABASE_SERVICE_ROLE_KEY=""

# Required in production. Used for canonical links, social preview cards and
# same-origin image resolution. Set the final public HTTPS origin before build;
# keep it server-only so a later runtime value is never replaced by an inlined
# localhost NEXT_PUBLIC_* value.
NEXT_PUBLIC_APP_NAME="Gooods Dex"
APP_URL="https://gubugu.example.com"
# Only for an explicit local `pnpm start` smoke test; never enable in deployment.
# ALLOW_INSECURE_LOCAL_APP_URL="1"

# Optional on a long-running production server. When enabled, startup waits
# for the recognition model so the first real request does not pay the cold load.
RECOGNITION_WARMUP="0"

# 长驻 Next.js 进程会在北京时间每天 10:00 / 22:00 扫描启用的采集来源。
# Serverless 部署应设为 0，并由平台定时任务调用 `pnpm crawler:run`。
CATALOG_CRAWLER_SCHEDULER="1"
# 生产环境应把此目录挂载到持久磁盘。
CATALOG_ASSET_DIR=".data/catalog-assets"

# Comma-separated allowlists checked by lib/admin-access.ts.
ADMIN_USER_EMAILS="admin@example.com"
ADMIN_USER_IDS=""
MODERATOR_USER_EMAILS=""
MODERATOR_USER_IDS=""

# P2 extension points only. No provider is connected in V1.
# PUSH_PROVIDER="disabled"
# LOGISTICS_PROVIDER="disabled"
# AUTHENTICITY_PROVIDER="disabled"
# SUBSCRIPTION_PROVIDER="disabled"
# RECOMMENDATION_PROVIDER="disabled"
