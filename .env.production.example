# ── VPS 部署用环境文件 ───────────────────────────────────────────────────────
# 把本文件复制成同目录的 `.env`（docker compose 自动读取），填好后再 up。
# 绝不要提交真实 .env。密钥请用强随机值。
# ─────────────────────────────────────────────────────────────────────────────

# 域名（DNS A 记录需指向本 VPS，80/443 放行）。Caddy 用它签发 HTTPS 证书。
APP_DOMAIN=gubugu.tlines.tech
# 公网源，必须与域名一致、纯 HTTPS、无路径/参数。用于规范链接、分享卡、图片域。
APP_URL=https://gubugu.tlines.tech
NEXT_PUBLIC_APP_NAME=Gooods Dex

# ── 自建 Postgres ──
POSTGRES_USER=gubugu
POSTGRES_DB=gubugu
# 强随机，至少 24 位。改了要与已存在的数据卷一致，否则连不上旧库。
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ── 认证：自托管，不依赖任何外部服务 ──
# 账号存在自建 Postgres 里（scrypt 口令哈希），会话 cookie 用下面这个密钥做
# HMAC 签名。必须至少 32 位且不可预测——泄露或过短等于任何人都能伪造任意用户的
# 会话。用 openssl rand -base64 48 生成，且切勿提交进 git。
LOCAL_AUTH_SECRET=

# 可选：留空即用上面的本地认证。将来若想切到 Supabase，填上这两项即可自动切换。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 后台权限白名单（逗号分隔）──
ADMIN_USER_EMAILS=you@example.com
ADMIN_USER_IDS=
MODERATOR_USER_EMAILS=
MODERATOR_USER_IDS=

# ── 识别模型与爬虫 ──
# 1=启动时预热 CLIP 模型（首个真实请求不必等 ~140s）。长驻服务器建议开。
RECOGNITION_WARMUP=1
# 1=进程内每天 10:00/22:00（北京时间）扫描采集来源。
CATALOG_CRAWLER_SCHEDULER=1
# 中国网络下 huggingface.co 常被墙时启用镜像，否则留空用官方源。
HF_MIRROR=https://hf-mirror.com

# ── 采集草稿的 LLM 校对（可选，OpenAI 兼容，默认 DeepSeek）──
DEEPSEEK_API_KEY=
CATALOG_TRANSLATE_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 镜像坐标（由 CI 部署脚本自动写入/覆盖，手动部署时也可自己填）──
# 例：ghcr.io/OWNER/gubugu-web:latest
WEB_IMAGE=
MIGRATOR_IMAGE=
