dist/
coverage/
*.tsbuildinfo

# Generated by `pnpm db:seed` from images/. Committing it means every seed run
# with a different source set shows up as a diff in tracked binaries.
/public/local-sample-images/

# Content-addressed images produced by the catalog crawler. Production must
# mount .data on persistent storage; generated files do not belong in git.
/.data/catalog-assets/

# Generated by Next. It flips between the dev and build variants of the
# routes.d.ts reference, so tracking it produces a diff on every build.
next-env.d.ts
